// pinup's own configuration - the tool updates itself from here, under the
// runner's rules plus the one manager the runner never enables: gomod.
// github-actions went with the image workflow it kept current; the images
// are copied from the golden image's pipeline now (docs/container-images.md).
// Arrays replace, so enabledManagers is repeated in full.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>devops/renovate-runner"],
  "enabledManagers": ["custom.regex", "dockerfile", "gitlabci", "gitlabci-include", "gomod"],
  // The parity corpus carries deliberately outdated pins, and test files
  // carry FROM lines and annotations as fixtures: Renovate's dockerfile
  // pattern matches dockerfile_test.go, measured.
  "ignorePaths": ["**/prometheus-exporter/**", "testdata/**", "**/*_test.go"],
  "packageRules": [
    {
      "description": "A rebuild of the Go image under the same exact tag moves the digest in GO_IMAGE and nothing else: the Go version is the one the tag names, and with -trimpath and CGO_ENABLED=0 the binaries are built to come out the same. The runner's regex manager finds that line, not the pipeline manager, so the bump would keep the default chore and cut a release of identical bytes for every rebuild. ci is no release type. The patch bump is not touched: it stays fix(deps) by the runner's rule and releases.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.ole-hartwig.eu/devops/images/golang"],
      "matchUpdateTypes": ["digest"],
      "semanticCommitType": "ci"
    }
  ]
}
