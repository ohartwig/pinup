{
  "name": "acme/website",
  "type": "project",
  "license": "proprietary",
  "repositories": [
    {"type": "composer", "url": "https://git.acme.test/api/v4/group/17/-/packages/composer/"}
  ],
  "require": {
    "php": "^8.4",
    "typo3/cms-core": "^13.4",
    "typo3/cms-backend": "^13.4",
    "typo3/cms-frontend": "^13.4",
    "typo3/cms-fluid-styled-content": "^13.4",
    "typo3/cms-install": "^13.4",
    "typo3/cms-seo": "^13.4",
    "typo3/cms-scheduler": "^13.4",
    "helhum/typo3-console": "^8.2",
    "b13/container": "^3.1",
    "georgringer/news": "^12.3",
    "friendsoftypo3/tt-address": "^9.0",
    "symfony/console": "^7.3",
    "symfony/yaml": "^7.3",
    "doctrine/dbal": "^4.2",
    "guzzlehttp/guzzle": "^7.9",
    "cweagans/composer-patches": "^2.0",
    "acme/sitepackage": "^5.0",
    "acme/analytics": "^2.1.0",
    "acme/client-a-news": "^1.3",
    "acme/client-a-sitepackage": "^3.0.0",
    "acme/content-provenance": "^1.0",
    "partner/typo3-widgets": "^0.9",
    "corp/consent": "^4.1",
    "corp/forms": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.86",
    "example/test-double": "^1.6"
  },
  "suggest": {
    "acme/search": "Full-text search across the site tree",
    "acme/newsletter": "Double opt-in subscriptions with list management"
  },
  "config": {
    "platform": {
      "php": "8.4.11"
    },
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true,
      "cweagans/composer-patches": true
    }
  },
  "extra": {
    "typo3/cms": {
      "web-dir": "public"
    }
  }
}
