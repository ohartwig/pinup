{
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    "abandonments:recommended",
    ":pinDevDependencies",
    ":automergeDigest",
    "customManagers:dockerfileVersions",
    "customManagers:gitlabPipelineVersions",
    "workarounds:typesNodeVersioning",
    "mergeConfidence:all-badges"
  ],
  "executionTimeout": 90,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/^\\.gitlab-ci\\.yml$/,/^templates(/.*)?/.*\\.ya?ml$/, datasourceTemplate=docker, versioningTemplate=docker",
      "managerFilePatterns": [
        "/^\\.gitlab-ci\\.yml$/",
        "/^templates(/.*)?/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:[a-z0-9_-]+_image|default):[^\\n]*",
        "(?<depName>registry\\.acme\\.test/devops/ci-mirrors/[a-z0-9._/-]+):(?<currentValue>[a-zA-Z0-9][a-zA-Z0-9._-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "matchStringsStrategy": "recursive"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/^\\.gitlab-ci\\.yml$/,/^templates(/.*)?/.*\\.ya?ml$/, datasourceTemplate=docker, versioningTemplate=docker",
      "managerFilePatterns": [
        "/^\\.gitlab-ci\\.yml$/",
        "/^templates(/.*)?/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:[a-z0-9_-]+_image|default):[^\\n]*",
        "(?<depName>registry\\.acme\\.test/devops/images/[a-z0-9._/-]+):(?<currentValue>[a-zA-Z0-9][a-zA-Z0-9._-]*)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "matchStringsStrategy": "recursive"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/^templates(/.*)?/.*\\.ya?ml$/, datasourceTemplate=docker",
      "managerFilePatterns": [
        "/^templates(/.*)?/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "name:\\s*(?<depName>[a-z0-9][a-z0-9._/-]*[a-z0-9]):(?<currentValue>[a-zA-Z0-9][a-zA-Z0-9._-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/^templates(/.*)?/.*\\.yml$/,/(^|/)\\.gitlab-ci\\.yml$/, datasourceTemplate={{{datasource}}}, versioningTemplate=semver",
      "managerFilePatterns": [
        "/^templates(/.*)?/.*\\.yml$/",
        "/(^|/)\\.gitlab-ci\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[^\\n]*\\n\\s*[^\\n]*?images/php-ci:(?<currentValue>\\d+\\.\\d+\\.\\d+)-\\$PHP_VERSION"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "registryUrlTemplate": "https://git.acme.test",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/^templates(/.*)?/.*\\.ya?ml$/, datasourceTemplate={{{datasource}}}, versioningTemplate={{{versioning}}}",
      "managerFilePatterns": [
        "/^templates(/.*)?/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+[A-Z][A-Z0-9_]*:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "versioningTemplate": "{{{versioning}}}"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)compose\\.ya?ml$/,/(^|/)compose\\.[^/]+\\.ya?ml$/,/(^|/)docker-compose\\.ya?ml$/,…, datasourceTemplate={{{datasource}}}, versioningTemplate={{{versioning}}}",
      "managerFilePatterns": [
        "/(^|/)compose\\.ya?ml$/",
        "/(^|/)compose\\.[^/]+\\.ya?ml$/",
        "/(^|/)docker-compose\\.ya?ml$/",
        "/(^|/)docker-compose\\.[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+image:\\s*\\S+:(?<currentValue>[^\\s:]+)"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "registryUrlTemplate": "https://git.acme.test",
      "versioningTemplate": "{{{versioning}}}",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^argocd-install/kustomization\\.yml$/"
      ],
      "matchStrings": [
        "https:\\/\\/raw\\.githubusercontent\\.com\\/argoproj\\/argo-cd\\/v(?<currentValue>\\S+)\\/manifests\\/install.yaml",
        "https:\\/\\/raw\\.githubusercontent\\.com\\/argoproj\\/argo-cd\\/v(?<currentValue>\\S+)\\/examples\\/k8s-rbac\\/argocd-server-applications\\/argocd-server-rbac-clusterrole\\.yaml",
        "https:\\/\\/raw\\.githubusercontent\\.com\\/argoproj\\/argo-cd\\/v(?<currentValue>\\S+)\\/examples\\/k8s-rbac\\/argocd-server-applications\\/argocd-server-rbac-clusterrolebinding\\.yaml"
      ],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^default-.*\\.yml$/",
        "/^build(/.*)?/.*\\.yml$/",
        "/^test(/.*)?/.*\\.yml$/",
        "/^deploy(/.*)?/.*\\.yml$/",
        "/^lint(/.*)?/.*\\.yml$/",
        "/^release(/.*)?/.*\\.yml$/",
        "/^templates(/.*)?/.*\\.yml$/"
      ],
      "versioningTemplate": "semver",
      "datasourceTemplate": "gitlab-releases",
      "registryUrlTemplate": "https://{{{registryUrl}}}",
      "depTypeTemplate": "repository",
      "description": "Twin manager: managerFilePatterns=/^default-.*\\.yml$/,/^build(/.*)?/.*\\.yml$/,/^test(/.*)?/.*\\.yml$/,…, versioningTemplate=semver, datasourceTemplate=gitlab-releases",
      "matchStrings": [
        "component: (?<registryUrl>[^\\s\\/]+)\\/(?<depName>\\S+)\\/[^\\s\\/]+@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/|\\.)Dockerfile$/,/(^|/)Dockerfile\\.[^/]*$/",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: (?:packageName|lookupName)=(?<packageName>.+?))?(?: versioning=(?<versioning>[a-z-]+?))?\\s+RUN install-[a-z]+? (?<depName>[a-z-]+?) (?<currentValue>.+?)\\s"
      ]
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/\\.sh$/",
      "managerFilePatterns": [
        "/\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)(?: (?:packageName|lookupName)=(?<packageName>.+?))?(?: versioning=(?<versioning>[a-z-]+?))?\\s+[A-Z_]+?_VERSION=(?<currentValue>.+?)\\s"
      ]
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)composer\\.json$/, datasourceTemplate=gitlab-packages, versioningTemplate=composer",
      "managerFilePatterns": [
        "/(^|/)composer\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>acme/[a-z0-9_-]+)\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "gitlab-packages",
      "registryUrlTemplate": "https://git.acme.test",
      "packageNameTemplate": "{{#if (equals depName 'acme/analytics')}}development/acme/typo3-analytics{{else}}{{#if (equals depName 'acme/client-a-news')}}development/client-a/extensions/client-a-news{{else}}{{#if (equals depName 'acme/client-a-sitepackage')}}development/client-a/extensions/sitepackage{{else}}development/{{depName}}{{/if}}{{/if}}{{/if}}:{{depName}}",
      "versioningTemplate": "composer",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)composer\\.json$/, datasourceTemplate=gitlab-packages, versioningTemplate=composer",
      "managerFilePatterns": [
        "/(^|/)composer\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>partner/typo3-widgets)\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "gitlab-packages",
      "registryUrlTemplate": "https://git.acme.test",
      "packageNameTemplate": "development/acme/typo3-widgets:{{depName}}",
      "versioningTemplate": "composer",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)composer\\.json$/, datasourceTemplate=gitlab-packages, versioningTemplate=composer",
      "managerFilePatterns": [
        "/(^|/)composer\\.json$/"
      ],
      "matchStrings": [
        "\"corp/(?<packageSuffix>[a-z0-9_-]+)\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "gitlab-packages",
      "registryUrlTemplate": "https://git.acme.test",
      "depNameTemplate": "corp/{{packageSuffix}}",
      "packageNameTemplate": "platform/core/{{packageSuffix}}:corp/{{packageSuffix}}",
      "versioningTemplate": "composer",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)\\.gitlab-ci\\.yml$/,/(^|/)templates/.*\\.ya?ml$/, datasourceTemplate=gitlab-releases, versioningTemplate=semver",
      "managerFilePatterns": [
        "/(^|/)\\.gitlab-ci\\.yml$/",
        "/(^|/)templates/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\$\\{?CI_SERVER_HOST\\}?/(?<depName>devops/ci-cd-components/[a-z0-9-]+)/[a-z0-9-]+@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "gitlab-releases",
      "registryUrlTemplate": "https://git.acme.test",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)tenants/.*\\.ya?ml$/,/(^|/)charts/.*/values\\.ya?ml$/,/^bootstrap/.*\\.ya?ml$/, datasourceTemplate={{{datasource}}}, versioningTemplate=semver",
      "managerFilePatterns": [
        "/(^|/)tenants/.*\\.ya?ml$/",
        "/(^|/)charts/.*/values\\.ya?ml$/",
        "/^bootstrap/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?) registryUrl=(?<registryUrl>\\S+?)\\s+tag:\\s*\"(?<currentValue>[^\"@]+?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\""
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "registryUrlTemplate": "{{{registryUrl}}}",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)tenants/.*\\.ya?ml$/,/(^|/)charts/.*/values\\.ya?ml$/,/^bootstrap/.*\\.ya?ml$/, datasourceTemplate={{{datasource}}}, versioningTemplate=semver",
      "managerFilePatterns": [
        "/(^|/)tenants/.*\\.ya?ml$/",
        "/(^|/)charts/.*/values\\.ya?ml$/",
        "/^bootstrap/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)\\s+tag:\\s*\"(?<currentValue>[^\"@]+?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\""
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)tenants/.*\\.ya?ml$/,/(^|/)charts/.*/values\\.ya?ml$/,/^bootstrap/.*\\.ya?ml$/, datasourceTemplate={{{datasource}}}, versioningTemplate=docker",
      "managerFilePatterns": [
        "/(^|/)tenants/.*\\.ya?ml$/",
        "/(^|/)charts/.*/values\\.ya?ml$/",
        "/^bootstrap/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?) registryUrl=(?<registryUrl>\\S+?)\\s+[A-Za-z][A-Za-z0-9_-]*:\\s*\"?(?<image>[^\\s\\\":]*/[^\\s\\\":]*):(?<currentValue>[^\\s\"@]+?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\"?\\s"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "registryUrlTemplate": "{{{registryUrl}}}",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)tenants/.*\\.ya?ml$/,/(^|/)charts/.*/values\\.ya?ml$/,/^bootstrap/.*\\.ya?ml$/, datasourceTemplate={{{datasource}}}, versioningTemplate=docker",
      "managerFilePatterns": [
        "/(^|/)tenants/.*\\.ya?ml$/",
        "/(^|/)charts/.*/values\\.ya?ml$/",
        "/^bootstrap/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)\\s+[A-Za-z][A-Za-z0-9_-]*:\\s*\"?(?<image>[^\\s\\\":]*/[^\\s\\\":]*):(?<currentValue>[^\\s\"@]+?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\"?\\s"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)Containerfile$/,/(^|/|\\.)Dockerfile$/, datasourceTemplate=custom.protonpass, versioningTemplate=semver",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/",
        "/(^|/|\\.)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate:\\s*datasource=custom\\.protonpass\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>[a-z-]+))?\\s+ARG PASS_CLI_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "custom.protonpass",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)\\.gitlab-ci\\.yml$/, datasourceTemplate={{{datasource}}}, versioningTemplate=semver",
      "managerFilePatterns": [
        "/(^|/)\\.gitlab-ci\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[A-Z_]+:\\s*\"(?<currentValue>[0-9][^\"]+)\"",
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+-\\s*install-tool\\s+\\S+\\s+(?<currentValue>[0-9]\\S*)"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)composer\\.json$/,/(^|/)composer\\.lock$/, datasourceTemplate=custom.wolfi, versioningTemplate=semver",
      "managerFilePatterns": [
        "/(^|/)composer\\.json$/",
        "/(^|/)composer\\.lock$/"
      ],
      "matchStrings": [
        "\"platform\"\\s*:\\s*\\{[^}]*?\"php\"\\s*:\\s*\"(?<currentValue>(?<phpSeries>\\d+\\.\\d+)(?:\\.\\d+)?)\"",
        "\"platform-overrides\"\\s*:\\s*\\{[^}]*?\"php\"\\s*:\\s*\"(?<currentValue>(?<phpSeries>\\d+\\.\\d+)(?:\\.\\d+)?)\""
      ],
      "depNameTemplate": "php-frankenphp-{{{phpSeries}}}",
      "datasourceTemplate": "custom.wolfi",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)Chart\\.ya?ml$/, datasourceTemplate={{{datasource}}}, versioningTemplate=semver",
      "managerFilePatterns": [
        "/(^|/)Chart\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?) registryUrl=(?<registryUrl>\\S+?)\\s+appVersion:\\s*\"(?<currentValue>[^\"]+?)\""
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "registryUrlTemplate": "{{{registryUrl}}}",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)Chart\\.ya?ml$/, datasourceTemplate={{{datasource}}}, versioningTemplate=semver",
      "managerFilePatterns": [
        "/(^|/)Chart\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)\\s+appVersion:\\s*\"(?<currentValue>[^\"]+?)\""
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Twin manager: managerFilePatterns=/(^|/)Containerfile$/,/(^|/|\\.)Dockerfile$/, datasourceTemplate=go, versioningTemplate=semver",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/",
        "/(^|/|\\.)Dockerfile$/"
      ],
      "matchStrings": [
        "--with\\s+(?<depName>[a-zA-Z0-9._/-]+)@(?<currentValue>v[0-9][^\\s\\\\]*)"
      ],
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    },
    {
      "description": "Twin manager: managerFilePatterns=/(^|/)\\.gitlab-ci\\.yml$/,/(^|/)templates/.*\\.ya?ml$/, datasourceTemplate=gitlab-releases, versioningTemplate=loose",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.gitlab-ci\\.yml$/",
        "/(^|/)templates/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\$\\{?CI_SERVER_HOST\\}?/(?<depName>devops/ci-cd-components/[a-z0-9-]+)/[a-z0-9-]+@(?<currentValue>\\d+)[\\r\\n]"
      ],
      "datasourceTemplate": "gitlab-releases",
      "versioningTemplate": "loose"
    }
  ],
  "customDatasources": {
    "wolfi": {
      "defaultRegistryUrlTemplate": "http://127.0.0.1:8099/{{packageName}}.json",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": versions }"
      ]
    },
    "corp-apk": {
      "defaultRegistryUrlTemplate": "http://127.0.0.1:8099/corp/{{packageName}}.json",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": versions }"
      ]
    },
    "protonpass": {
      "defaultRegistryUrlTemplate": "https://proton.me/download/pass-cli/versions.json",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": [ { \"version\": passCliVersions.version } ] }"
      ]
    }
  },
  "dependencyDashboard": true,
  "ignorePaths": [
    "**/prometheus-exporter/**"
  ],
  "ignoreDeps": [
    "example/legacy-sdk",
    "example/test-double"
  ],
  "prHourlyLimit": 20,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "enabledManagers": [
    "custom.regex",
    "npm",
    "kustomize",
    "dockerfile",
    "composer",
    "gitlabci",
    "gitlabci-include",
    "terraform",
    "terraform-version",
    "gomod"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Twin rule: matchPackageNames=* -> rangeStrategy=replace",
      "matchPackageNames": [
        "*"
      ],
      "rangeStrategy": "replace"
    },
    {
      "description": "Twin rule: matchDatasources=npm -> minimumReleaseAge=3 days, internalChecksFilter=strict",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Twin rule: matchDatasources=npm; matchUpdateTypes=lockFileMaintenance,replacement,pin -> minimumReleaseAge=None",
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "replacement",
        "pin"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Twin rule: matchDatasources=npm; matchPackageNames=@acme/**,@corp/** -> minimumReleaseAge=0",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@acme/**",
        "@corp/**"
      ],
      "minimumReleaseAge": "0"
    },
    {
      "description": "Twin rule: matchUpdateTypes=minor,patch,digest,… -> automerge=True",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "automerge": true
    },
    {
      "description": "Twin rule: matchDatasources=custom.wolfi,custom.corp-apk; matchUpdateTypes=patch,minor -> groupName=alpine + wolfi packages, groupSlug=apk, minimumReleaseAge=0, automerge=True",
      "matchDatasources": [
        "custom.wolfi",
        "custom.corp-apk"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "alpine + wolfi packages",
      "groupSlug": "apk",
      "minimumReleaseAge": "0",
      "automerge": true
    },
    {
      "matchDatasources": [
        "composer"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "composer packages",
      "groupSlug": "composer"
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "npm packages",
      "groupSlug": "npm"
    },
    {
      "description": "Twin rule: matchDatasources=npm; matchPackageNames=@acme/eslint-config -> registryUrls=https://git.acme.test/api/v4/projects/101/packages/npm/",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@acme/eslint-config"
      ],
      "registryUrls": [
        "https://git.acme.test/api/v4/projects/101/packages/npm/"
      ]
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@acme/stylelint-config"
